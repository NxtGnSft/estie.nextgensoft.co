---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { productWaLink } from '../data/company';
interface Props { product: CollectionEntry<'products'>['data']; }
const { product: p } = Astro.props;
---
<article class="card reveal" id={p.slug}
  data-code={p.code} data-name={p.name} data-material={p.material} data-dimensions={p.dimensions.raw}
  data-finish={p.finish ?? ''} data-fabric={p.fabric ?? ''} data-leather={p.leather ?? ''}
  data-wa={productWaLink(p.code, p.name)}>
  <button class="card-open" type="button" aria-label={`Open ${p.code} ${p.name}`}>
    <Image src={p.image} alt={`${p.code}, ${p.name}`} width={520} height={490} />
  </button>
  <div class="meta">
    <span class="mono code">{p.code}</span>
    <h2>{p.name}</h2>
    <p class="spec">{p.material}</p>
    <p class="spec mono">{p.dimensions.raw}</p>
  </div>
</article>
<style>
  .card { display: flex; flex-direction: column; gap: 0.75rem; }
  .card[hidden] { display: none; }
  .card-open { all: unset; cursor: pointer; display: block; background: var(--grey); aspect-ratio: 16 / 15; overflow: hidden; }
  .card-open:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .card-open img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .card:hover .card-open img { transform: scale(1.03); }
  .code { color: var(--amber); }
  h2 { font-size: 1.15rem; margin-top: 0.15rem; }
  .spec { margin: 0.1rem 0 0; color: var(--ink-soft); font-size: 0.9rem; }
  .spec.mono { text-transform: none; letter-spacing: 0; }
</style>
