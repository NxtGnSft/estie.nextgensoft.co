---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/categories';
import { COMPANY, waLink } from '../data/company';
import hero from '../assets/site/hero.jpg';

const products = await getCollection('products');
const tiles = CATEGORIES.map((c) => {
  const items = products.filter((p) => p.data.category === c.slug);
  return { ...c, count: items.length, cover: items[0].data.image };
});

const processImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/site/process-*.png', { eager: true });
const projectImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/site/project-*.png', { eager: true });
const swatchImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/site/swatch-*.png', { eager: true });
const sorted = (m: Record<string, { default: ImageMetadata }>) => Object.keys(m).sort().map((k) => m[k].default);

const PROCESS = ['Raw material', 'Kiln dry / oven', 'Craftsman', 'Over process', 'Sanding', 'QC', 'Packing', 'Loading'];
const PROJECTS = ['Cafes and restaurants', 'Cafes and restaurants', 'Villa and hotel', 'Villa and hotel', 'Cafe, resto and bar', 'Cafe, resto and bar'];
const SWATCHES = { 'swatch-fabric': 'Fabric', 'swatch-finish': 'Finishing colour', 'swatch-rattan': 'Rattan', 'swatch-webbing': 'Webbing' } as const;
const heroBg = await getImage({ src: hero, width: 2000, format: 'webp' });
---
<Base title="Teak furniture for cafes, hotels and homes" description={`${COMPANY.legalName}: export-quality teak furniture made in Semarang. ${products.length} dining chairs, tables, stools, lounge chairs, sofas and cabinets, finish and fabric by request.`}>
  <section id="hero" class="hero" style={`background-image:url(${heroBg.src})`}>
    <div class="container hero-inner">
      <p class="mono">Semarang, Indonesia · Est. teak workshop</p>
      <h1>Teak furniture, made to order for cafes, hotels and homes.</h1>
      <p class="lead">Export-quality craftsmanship, kiln-dried teak, finish and fabric to your specification.</p>
      <p class="actions">
        <a class="btn btn-primary" href="/catalog/dining-chairs/">Browse the catalog</a>
        <a class="btn btn-ghost" href={waLink()} target="_blank" rel="noopener">WhatsApp us</a>
      </p>
    </div>
  </section>

  <section id="categories" class="section container">
    <p class="section-label">01 Catalog</p>
    <ul class="tiles">
      {tiles.map((t) => (
        <li class="reveal">
          <a href={`/catalog/${t.slug}/`}>
            <Image src={t.cover} alt="" width={480} height={450} />
            <span class="tile-text"><span>{t.title}</span><span class="mono">{t.count} items</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <hr class="hairline" />
  <section id="process" class="section container">
    <p class="section-label">02 Production process</p>
    <h2 class="reveal">We take pride in furniture that exceeds export-quality standards.</h2>
    <p class="lead reveal">Every piece is inspected by our quality control team for craftsmanship, durability, and a flawless finish.</p>
    <ol class="strip">
      {sorted(processImgs).map((img, i) => (
        <li class="reveal">
          <Image src={img} alt="" width={420} />
          <span class="mono">{String(i + 1).padStart(2, '0')} {PROCESS[i]}</span>
        </li>
      ))}
    </ol>
  </section>

  <hr class="hairline" />
  <section id="projects" class="section container">
    <p class="section-label">03 Our projects</p>
    <ul class="projects">
      {sorted(projectImgs).map((img, i) => (
        <li class="reveal"><Image src={img} alt={PROJECTS[i]} width={800} /><span class="mono">{PROJECTS[i]}</span></li>
      ))}
    </ul>
  </section>

  <hr class="hairline" />
  <section id="materials" class="section container">
    <p class="section-label">04 Materials</p>
    <h2 class="reveal">Finish and fabric by request.</h2>
    <ul class="swatches">
      {Object.entries(SWATCHES).map(([key, label]) => (
        <li class="reveal"><Image src={swatchImgs[`../assets/site/${key}.png`].default} alt={`${label} samples`} width={640} /><span class="mono">{label}</span></li>
      ))}
    </ul>
  </section>
  <hr class="hairline" />
</Base>

<style>
  .hero { min-height: 92svh; display: grid; align-items: end; background-size: cover; background-position: center; color: #fff; position: relative; }
  .hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(46,53,36,0.85), rgba(46,53,36,0.15) 60%); }
  .hero-inner { position: relative; padding-block: clamp(3rem, 8vw, 6rem); max-width: 60ch; }
  .hero .lead { font-size: 1.15rem; max-width: 48ch; opacity: 0.9; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .lead { color: var(--ink-soft); max-width: 56ch; }
  .tiles, .strip, .projects, .swatches { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .tiles { grid-template-columns: repeat(2, 1fr); }
  .tiles a { display: block; text-decoration: none; background: var(--grey); position: relative; aspect-ratio: 16 / 15; overflow: hidden; }
  .tiles img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .tiles a:hover img { transform: scale(1.04); }
  .tile-text { position: absolute; inset: auto 0 0 0; padding: 0.75rem 1rem; background: linear-gradient(to top, rgba(46,53,36,0.9), transparent); color: #fff; display: flex; justify-content: space-between; align-items: baseline; }
  .strip { grid-template-columns: repeat(2, 1fr); margin-top: 2rem; counter-reset: step; }
  .strip img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .strip .mono, .projects .mono, .swatches .mono { display: block; margin-top: 0.5rem; color: var(--ink-soft); }
  .projects { grid-template-columns: repeat(2, 1fr); }
  .projects img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .swatches { grid-template-columns: repeat(2, 1fr); margin-top: 2rem; }
  .swatches img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  @media (min-width: 800px) { .tiles { grid-template-columns: repeat(3, 1fr); } .strip { grid-template-columns: repeat(4, 1fr); } .projects { grid-template-columns: repeat(3, 1fr); } .swatches { grid-template-columns: repeat(4, 1fr); } }
</style>
